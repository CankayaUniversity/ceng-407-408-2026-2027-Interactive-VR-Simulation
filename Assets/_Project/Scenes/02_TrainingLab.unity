  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Simulation.Interaction.CockpitInspectionManager
  targetCamera: {fileID: 1309495186}
  moveSmoothTime: 0.45
  rotateSpeed: 8
  fovSmoothTime: 0.35
  defaultOverviewPos: {x: 0, y: 0.48, z: -0.05}
  defaultOverviewLookAt: {x: 0, y: 0.85, z: 0.9}
  defaultOverviewFOV: 70
  captainSeatPos: {x: 0.46, y: 0.42, z: 0.15}
  captainSeatLookAt: {x: 0.34, y: 0.85, z: 0.9}
  hotspots:
  - id: 1
    objectName: 01_Cyclic_Captain
    title: Cyclic (Captain)
    subtitle: Primary Flight Control Stick
    description: Controls helicopter pitch and roll attitude. Features contoured
      grip with 4-way trim hat, autopilot disconnect, and PTT trigger.
    cameraPosition: {x: 0.46, y: 0.58, z: 0.12}
    cameraLookAt: {x: 0.46, y: 0.36, z: 0.36}
    fieldOfView: 40
  - id: 2
    objectName: 02_Collective_Captain
    title: Collective Lever (Captain)
    subtitle: Main Rotor Thrust & Power
    description: Controls main rotor blade pitch angle collectively. Includes twist-grip
      throttle friction collar and multi-switch control head.
    cameraPosition: {x: 0.24, y: 0.52, z: -0.06}
    cameraLookAt: {x: 0.24, y: 0.28, z: 0.3}
    fieldOfView: 38
  - id: 3
    objectName: 03_YawPedals_Captain
    title: Yaw Pedals (Captain)
    subtitle: Antitorque / Tail Rotor Control
    description: Controls heading and yaw axis via tail rotor pitch. Dual adjustable
      ribbed metal pedals with differential toe braking.
    cameraPosition: {x: 0.46, y: 0.45, z: 0.55}
    cameraLookAt: {x: 0.46, y: 0.1, z: 0.88}
    fieldOfView: 35
  - id: 4
    objectName: 04_MFD_Captain
    title: MFD Captain (PFD)
    subtitle: Primary Flight Display
    description: Helionix electronic flight instrument display presenting artificial
      horizon, airspeed tape, altitude tape, vertical speed, and compass rose.
    cameraPosition: {x: 0.34, y: 0.9, z: 0.55}
    cameraLookAt: {x: 0.34, y: 0.9, z: 0.9}
    fieldOfView: 35
  - id: 5
    objectName: 05_VMS_Display
    title: VMS (Vehicle Monitoring System)
    subtitle: Vehicle monitoring system (engine indicators)
    description: "Displays dual engine torque (TRQ 39.0%), turbine outlet temperature
      (TOT 535\xB0C), N1/N2 rotor speed, hydraulic pressures, engine & gearbox oil
      status, fuel quantity, and gross weight (3000 Kg)."
    cameraPosition: {x: 0, y: 0.9, z: 0.55}
    cameraLookAt: {x: 0, y: 0.9, z: 0.9}
    fieldOfView: 35
  - id: 6
    objectName: 06_IEASI
    title: IEASI (Standby Indicator)
    subtitle: Integrated Electronic Attitude Situation Indicator
    description: Independent solid-state backup artificial horizon with digital barometric
      altimeter (1017 hPa), airspeed tape, and slip indicator.
    cameraPosition: {x: -0.17, y: 0.98, z: 0.7}
    cameraLookAt: {x: -0.17, y: 0.98, z: 0.98}
    fieldOfView: 30
  - id: 7
    objectName: 07_MFD_CoPilot_Upper
    title: MFD Co-Pilot (PFD)
    subtitle: Co-Pilot Multi-Function Display
    description: Left primary flight display duplicating captain flight parameters
      with independent sensor selection, navigation mapping, and synthetic vision.
    cameraPosition: {x: -0.38, y: 0.9, z: 0.55}
    cameraLookAt: {x: -0.38, y: 0.9, z: 0.9}
    fieldOfView: 35
  - id: 8
    objectName: 08_MFD_Center_Dual
    title: Center Dual Navigation Displays
    subtitle: Tactical Navigation & Radar
    description: Dual high-contrast displays on slanted console showing moving map,
      tactical radar sweep, waypoints, and terrain elevation.
    cameraPosition: {x: 0, y: 0.72, z: 0.38}
    cameraLookAt: {x: 0, y: 0.62, z: 0.52}
    fieldOfView: 35
  - id: 9
    objectName: 09_Audio_Panels
    title: Audio Control Panels
    subtitle: Communications & Intercom (ICS)
    description: Dual audio control units managing VHF/UHF radios, passenger intercom,
      crew isolation modes, and volume levels.
    cameraPosition: {x: 0, y: 0.62, z: 0.32}
    cameraLookAt: {x: 0, y: 0.54, z: 0.44}
    fieldOfView: 32
  - id: 10
    objectName: 10_Remote_Compass_Slave
    title: Remote Compass Slave
    subtitle: Directional Gyro / Flux Calibrator
    description: Magnetic compass slaving controller providing manual and automatic
      synchronization between directional gyros and external flux gate.
    cameraPosition: {x: -0.07, y: 0.54, z: 0.3}
    cameraLookAt: {x: -0.07, y: 0.47, z: 0.35}
    fieldOfView: 30
  - id: 11
    objectName: 11_Autopilot_Control_Panel
    title: Autopilot Control Panel (AFCS)
    subtitle: 4-Axis Automatic Flight Control
    description: 'Selects automatic flight control modes: Heading (HDG), Altitude
      Hold (ALT), Navigation (NAV), Vertical Speed (VS), and Go-Around (GA).'
    cameraPosition: {x: -0.07, y: 0.48, z: 0.28}
    cameraLookAt: {x: -0.07, y: 0.42, z: 0.25}
    fieldOfView: 30
  - id: 12
    objectName: 12_I_Drive_Control
    title: I-Drive Rotary Controller
    subtitle: Multi-Function Input Device
    description: Large fluted rotary encoder used for rapid scrolling, menu selection,
      and flight plan waypoint entry across all cockpit screens.
    cameraPosition: {x: -0.08, y: 0.42, z: 0.24}
    cameraLookAt: {x: -0.08, y: 0.36, z: 0.12}
    fieldOfView: 30
  - id: 13
    objectName: 13_Weather_Radar_Panel
    title: Weather Radar Controller
    subtitle: Digital Radar Gain & Scan Control
    description: Controls weather radar range rings, gain, tilt angle, ground clutter
      suppression, and storm cell detection modes.
    cameraPosition: {x: -0.07, y: 0.36, z: 0.2}
    cameraLookAt: {x: -0.07, y: 0.36, z: 0.01}
    fieldOfView: 30
  - id: 14
    objectName: 14_ELT_Switch
    title: ELT Emergency Locator Switch
    subtitle: Emergency Locator Transmitter (406 MHz)
    description: Tri-state guarded switch (ARM / ON / TEST) controlling satellite
      distress beacon with armed g-force impact trigger.
    cameraPosition: {x: 0.07, y: 0.6, z: 0.35}
    cameraLookAt: {x: 0.07, y: 0.54, z: 0.44}
    fieldOfView: 28
  - id: 15
    objectName: 15_Engine_Main_Switches
    title: Engine Main Switches
    subtitle: Dual FADEC Engine Control Levers
    description: Main powerplant control panel with dual yellow lever toggle switches
      (FLIGHT / IDLE / OFF) protected by red hinged safety guards.
    cameraPosition: {x: 0.09, y: 0.78, z: 0.5}
    cameraLookAt: {x: 0.09, y: 0.72, z: 0.6}
    fieldOfView: 30
  - id: 16
    objectName: 16_FMS_Selectors
    title: FMS Mode Selectors
    subtitle: Flight Management System Selectors
    description: Rotary selector knobs and pushbuttons for navigation mode switching,
      barometric reference setting, and flight plan stepping.
    cameraPosition: {x: -0.11, y: 0.78, z: 0.5}
    cameraLookAt: {x: -0.11, y: 0.72, z: 0.6}
    fieldOfView: 30
  - id: 17
    objectName: 17_Fire_Warning_Light
    title: Engine Fire Warning Light
    subtitle: Master Fire Alarm & Extinguisher
    description: High-intensity illuminated red warning indicator alerting crew of
      engine bay overheat or fire, with built-in push action to arm discharge.
    cameraPosition: {x: 0.13, y: 1.1, z: 0.75}
    cameraLookAt: {x: 0.13, y: 1.05, z: 0.6}
    fieldOfView: 28
  - id: 18
    objectName: 18_Caution_Warnings_Panel
    title: Caution & Warning Annunciator
    subtitle: Master Caution LED Strip
    description: Central LED warning bar displaying amber caution and green advisory
      annunciations across electrical, hydraulic, and rotor systems.
    cameraPosition: {x: 0, y: 1.1, z: 0.75}
    cameraLookAt: {x: 0, y: 1.05, z: 0.6}
    fieldOfView: 32
  - id: 19
    objectName: 19_Magnetic_Compass
    title: Standby Magnetic Compass
    subtitle: Direct-Reading Wet Compass
    description: Liquid-filled magnetic compass mounted centrally on the vertical
      windshield center post, independent of electrical power.
    cameraPosition: {x: 0, y: 1.18, z: 0.85}
    cameraLookAt: {x: 0, y: 1.18, z: 0.48}
    fieldOfView: 30
  - id: 20
    objectName: 20_Collective_CoPilot
    title: Collective Lever (Co-Pilot)
    subtitle: Co-Pilot Rotor Thrust Control
    description: Left-hand collective pitch control lever for Co-pilot seat, mechanically
      synchronized with captain collective.
    cameraPosition: {x: -0.68, y: 0.52, z: -0.06}
    cameraLookAt: {x: -0.68, y: 0.28, z: 0.3}
    fieldOfView: 38
  - id: 21
    objectName: 21_YawPedals_CoPilot
    title: Yaw Pedals (Co-Pilot)
    subtitle: Co-Pilot Antitorque Pedals
    description: Dual foot pedals on left cockpit floor governing tail rotor antitorque
      and directional heading.
    cameraPosition: {x: -0.46, y: 0.45, z: 0.55}
    cameraLookAt: {x: -0.46, y: 0.1, z: 0.88}
    fieldOfView: 35
  - id: 22
    objectName: 22_Cyclic_CoPilot
    title: Cyclic (Co-Pilot)
    subtitle: Co-Pilot Flight Control Stick
    description: Dual-control cyclic stick in front of Co-pilot seat with ergonomic
      flight grip, trim switches, and AP override.
    cameraPosition: {x: -0.46, y: 0.58, z: 0.12}
    cameraLookAt: {x: -0.46, y: 0.36, z: 0.36}
    fieldOfView: 40
  currentHotspotIndex: -1
  isInspecting: 0
